# Copy to `.env` and adjust. `.env` is git-ignored.
# Auth uses Microsoft Entra ID (DefaultAzureCredential): run `az login` locally;
# on Azure ML compute the managed identity / `az login --identity` is used.
# API keys are NOT used: local auth is disabled on the Foundry resource.

AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=

# Foundry (AIServices) resource that hosts the gpt-6-luna and Decision-1 deployments.
AZURE_AI_RESOURCE=
# Optional overrides (derived from AZURE_AI_RESOURCE when unset):
# AZURE_OPENAI_BASE_URL=https://llm-decisions-resource.openai.azure.com/openai/v1/
# AZURE_AI_ENDPOINT=https://llm-decisions-resource.services.ai.azure.com

GPT6_LUNA_DEPLOYMENT=gpt-6-luna
DECISION1_DEPLOYMENT=Decision-1

# Azure ML workspace + GPU compute instance for open-weight models.
AML_WORKSPACE=
AML_LOCATION=swedencentral
AML_COMPUTE_NAME=
AML_COMPUTE_SIZE=Standard_NC24ads_A100_v4

OSS_MODEL_ID=openai/gpt-oss-20b
# HF_TOKEN=
# Pay-as-you-go hourly price of AML_COMPUTE_SIZE, used for local cost accounting.
# GPU_HOURLY_PRICE_USD=
