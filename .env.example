# Copy to `.env` and adjust. `.env` is git-ignored.
# Auth uses Microsoft Entra ID (DefaultAzureCredential): `az login` locally,
# managed identity on Azure compute. API keys are not used (local auth is disabled).

AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=

# Foundry resource + project hosting the deployments (deployment names: configs/models/*.yaml).
AZURE_AI_RESOURCE=
AZURE_AI_PROJECT=
# Optional overrides (derived from AZURE_AI_RESOURCE when unset):
# AZURE_OPENAI_BASE_URL=
# AZURE_AI_ENDPOINT=

# OpenAI platform key, only for the OpenAI Decisions API (A2) until Azure serves it.
# OPENAI_API_KEY=

# Azure ML workspace (in AZURE_RESOURCE_GROUP) + GPU compute cluster for C-series jobs.
AML_WORKSPACE=
AML_COMPUTE=

# HF_TOKEN=
